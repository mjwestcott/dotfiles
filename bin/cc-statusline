#!/usr/bin/env bash

# All data comes from Claude Code's stdin JSON — no external calls, so the
# statusline stays instant regardless of ~/.claude/projects/ size.
# For cost/usage info, run `ccusage` from the CLI when needed.

input=$(cat)

model=$(echo "$input" | jq -r '.model.display_name // "Unknown"' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
# Current context = input + cache_creation + cache_read from the most recent API call.
# (total_input_tokens is cumulative across the session, not what we want here.)
context_tokens=$(echo "$input" | jq -r '
    (.context_window.current_usage // {}) as $u
    | (($u.input_tokens // 0) + ($u.cache_creation_input_tokens // 0) + ($u.cache_read_input_tokens // 0))
')
context_pct=$(echo "$input" | jq -r '.context_window.used_percentage // 0 | round')
rate_pct=$(echo "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty | round')
week_pct=$(echo "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty | round')
reset_epoch=$(echo "$input" | jq -r '.rate_limits.five_hour.resets_at // empty')
cost_usd=$(echo "$input" | jq -r '.cost.total_cost_usd // empty')
lines_added=$(echo "$input" | jq -r '.cost.total_lines_added // 0')
lines_removed=$(echo "$input" | jq -r '.cost.total_lines_removed // 0')

# Countdown to 5-hour rate limit reset (== ccusage session block boundary)
block_left=""
if [ -n "$reset_epoch" ]; then
    remaining=$((reset_epoch - $(date +%s)))
    if [ "$remaining" -gt 0 ]; then
        block_left="$((remaining / 3600))h$(((remaining % 3600) / 60))m"
    fi
fi

if [ "$context_tokens" -ge 1000000 ] 2>/dev/null; then
    ctx_display="$(echo "$context_tokens" | awk '{printf "%.1fm", $1/1000000}')"
elif [ "$context_tokens" -ge 1000 ] 2>/dev/null; then
    ctx_display="$(echo "$context_tokens" | awk '{printf "%.0fk", $1/1000}')"
else
    ctx_display="${context_tokens}"
fi

branch=$(git branch --show-current 2>/dev/null)

# --- Colors (ANSI) ---
# Claude Code applies ambient dim to the whole statusline, so values are
# explicitly bright+bold to override it; labels/chrome stay at default and
# appear dim through CC's rendering.
B=$'\033[0;38;2;225;225;218m'  # subtly warm off-white, less cream than Zenburn fg
Y=$'\033[0;38;2;230;200;110m'  # warm yellow (warning)
R=$'\033[0;38;2;240;130;130m'  # soft red (critical)
G=$'\033[0;38;2;140;200;140m'  # muted green (diff additions, GitHub-ish)
D=$'\033[0;38;2;230;130;130m'  # muted red (diff deletions, GitHub-ish)
N=$'\033[0m'          # reset (back to CC's ambient dim)
S=" | "               # separator (plain, gets dimmed by CC)

pct_color() {
    local p=${1:-0}
    [[ "$p" =~ ^[0-9]+$ ]] || { printf '%s' "$B"; return; }
    if [ "$p" -ge 80 ]; then printf '%s' "$R"
    elif [ "$p" -ge 50 ]; then printf '%s' "$Y"
    else printf '%s' "$B"
    fi
}
ctx_c=$(pct_color "$context_pct")
rate_c=$(pct_color "$rate_pct")

week_c=$(pct_color "$week_pct")

line="${B}${model}${N}${S}${B}${branch}${N}${S}"
line+="ctx:${ctx_c}${ctx_display}${N}"
[ -n "$block_left" ] && line+="${S}block:${B}${block_left}${N}"
if [ -n "$rate_pct" ] || [ -n "$week_pct" ]; then
    line+="${S}rate:"
    [ -n "$rate_pct" ] && line+="${rate_c}${rate_pct}${N}%"
    [ -n "$rate_pct" ] && [ -n "$week_pct" ] && line+="/"
    [ -n "$week_pct" ] && line+="${week_c}${week_pct}${N}%wk"
fi
if [ "$lines_added" != "0" ] || [ "$lines_removed" != "0" ]; then
    line+="${S}${G}+${lines_added}${N} ${D}-${lines_removed}${N}"
fi
if [ -n "$cost_usd" ]; then
    cost_fmt=$(printf '%.2f' "$cost_usd")
    line+="${S}cost:\$${B}${cost_fmt}${N}"
fi
printf '%s\n' "$line"
