#!/usr/bin/env bash
#
# Idempotent installation script for macOS dotfiles environment

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Colour

# Helper functions
info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# Check we're on macOS
if [[ $(uname -s) != 'Darwin' ]]; then
    error "This script is for macOS only"
fi

# Check dotfiles directory exists
if [[ ! -e ~/dotfiles ]]; then
    error "$HOME/dotfiles does not exist. Clone the repository first: git clone https://github.com/mjwestcott/dotfiles.git $HOME/dotfiles"
fi

info "Starting dotfiles installation..."

# ============================================================================
# Homebrew
# ============================================================================
if ! command -v brew &> /dev/null; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    else
        info "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [[ -x /opt/homebrew/bin/brew ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [[ -x /usr/local/bin/brew ]]; then
            eval "$(/usr/local/bin/brew shellenv)"
        else
            error "Homebrew was installed but brew is not available"
        fi
    fi
else
    info "Homebrew already installed"
fi

# Homebrew requires explicit trust for third-party taps. Both are intentional:
# minio/stable provides the MinIO client/server, while yqrashawn/goku is the
# Karabiner configurator (Homebrew core's `goku` is an unrelated load tester).
for trusted_tap in minio/stable yqrashawn/goku; do
    brew tap "$trusted_tap"
    brew trust --tap "$trusted_tap"
done

# Install packages from Brewfile
info "Installing/updating packages from Brewfile..."
brew bundle --verbose --file=~/dotfiles/Brewfile

# ============================================================================
# Development Tools
# ============================================================================

# Rust
if command -v rustc &> /dev/null; then
    info "Rust already installed ($(rustc --version))"
else
    info "Installing Rust..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    source "$HOME/.cargo/env"
fi

# Claude Code (native binary - recommended by Anthropic)
if command -v claude &> /dev/null; then
    info "Claude Code already installed"
else
    info "Installing Claude Code..."
    curl -fsSL https://claude.ai/install.sh | bash
fi

# Global npm packages
if command -v npm &> /dev/null; then
    info "Installing/updating global npm packages..."
    npm install -g @openai/codex
    npm install -g @google/gemini-cli
else
    warn "npm not found, skipping global npm package installation"
fi

# ============================================================================
# Shell and Plugin Managers
# ============================================================================

# Antidote (Zsh plugin manager)
if [[ -e ~/.antidote ]]; then
    info "Antidote already installed, updating..."
    cd ~/.antidote && git pull --quiet
else
    info "Installing Antidote..."
    git clone --depth=1 https://github.com/mattmc3/antidote.git ~/.antidote
fi


# Tmux Plugin Manager
if [[ -e ~/.tmux/plugins/tpm ]]; then
    info "TPM already installed, updating..."
    cd ~/.tmux/plugins/tpm && git pull --quiet
else
    info "Installing Tmux Plugin Manager..."
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
fi

# zsh-bench (shell performance monitoring)
if [[ -e ~/dotfiles/tools/zsh-bench ]]; then
    info "zsh-bench already installed, updating..."
    cd ~/dotfiles/tools/zsh-bench && git pull --quiet
else
    info "Installing zsh-bench..."
    mkdir -p ~/dotfiles/tools
    git clone --depth=1 https://github.com/romkatv/zsh-bench.git ~/dotfiles/tools/zsh-bench
fi

# ============================================================================
# Dotfiles Symlinks
# ============================================================================

info "Creating dotfiles symlinks..."

# Function to create a symlink with smart backup
create_symlink() {
    local source="$1"
    local target="$2"

    # If target already points to the correct source, skip
    if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source" ]]; then
        return 0
    fi

    # If target exists and is not a symlink to our dotfiles, back it up
    if [[ -e "$target" ]] && [[ ! -L "$target" || "$(readlink "$target")" != "$source" ]]; then
        local backup_dir
        backup_dir=~/dotfiles/backup/$(date +%Y%m%d_%H%M%S)
        mkdir -p "$backup_dir"
        mv "$target" "$backup_dir/$(basename "$target")"
        warn "Backed up existing $(basename "$target") to $backup_dir"
    fi

    # Create the symlink
    ln -sfn "$source" "$target"
}

# Shell configs and other dotfiles
cd ~/dotfiles
for path in shell/zsh/* readline/* git/* tmux/tmux.conf rg/rgignore conda/*; do
    if [[ -e "$path" ]]; then
        file=$(basename "$path")
        create_symlink "$HOME/dotfiles/$path" "$HOME/.$file"
    fi
done

# Plugin manager configurations
create_symlink ~/dotfiles/antidote/zsh_plugins.txt ~/.zsh_plugins.txt

# .config directory symlinks
mkdir -p ~/.config

# Neovim. lazy.nvim writes the lockfile next to init.lua, so symlinking it keeps
# plugin versions in the repo and reproducible across machines.
mkdir -p ~/.config/nvim
create_symlink ~/dotfiles/vim/init.lua ~/.config/nvim/init.lua
create_symlink ~/dotfiles/vim/lua ~/.config/nvim/lua
create_symlink ~/dotfiles/vim/lazy-lock.json ~/.config/nvim/lazy-lock.json

# Database CLIs
mkdir -p ~/.config/pgcli
create_symlink ~/dotfiles/pgcli/config ~/.config/pgcli/config

mkdir -p ~/.config/litecli
create_symlink ~/dotfiles/litecli/config ~/.config/litecli/config

# Terminal and prompt
create_symlink ~/dotfiles/starship/starship.toml ~/.config/starship.toml

# Ghostty
mkdir -p ~/.config/ghostty
create_symlink ~/dotfiles/ghostty/config ~/.config/ghostty/config

# Ranger file manager
mkdir -p ~/.config/ranger/colorschemes
create_symlink ~/dotfiles/ranger/rc.conf ~/.config/ranger/rc.conf
create_symlink ~/dotfiles/ranger/scope.sh ~/.config/ranger/scope.sh
create_symlink ~/dotfiles/ranger/rifle.conf ~/.config/ranger/rifle.conf
create_symlink ~/dotfiles/ranger/zenburn.py ~/.config/ranger/colorschemes/zenburn.py

# Bat (better cat)
mkdir -p ~/.config/bat
create_symlink ~/dotfiles/bat/config ~/.config/bat/config

# Broot (tree-based file browser)
mkdir -p ~/.config/broot
create_symlink ~/dotfiles/broot/conf.hjson ~/.config/broot/conf.hjson
create_symlink ~/dotfiles/broot/verbs.hjson ~/.config/broot/verbs.hjson
create_symlink ~/dotfiles/broot/skins ~/.config/broot/skins

# Generate broot's `br` shell launcher. The zsh config also guards this file so
# a missing optional integration never prevents a shell from loading.
if command -v broot &> /dev/null && [[ ! -r ~/.config/broot/launcher/bash/br ]]; then
    broot --install || warn "Could not install the broot shell launcher"
fi

# Karabiner
create_symlink ~/dotfiles/karabiner/karabiner.edn ~/.config/karabiner.edn

# Claude config
mkdir -p ~/.claude
create_symlink ~/dotfiles/claude/settings.json ~/.claude/settings.json
for dir in hooks agents skills; do
    if [[ -d ~/dotfiles/claude/$dir ]]; then
        create_symlink "$HOME/dotfiles/claude/$dir" "$HOME/.claude/$dir"
    elif [[ -L ~/.claude/$dir ]] && [[ ! -e ~/.claude/$dir ]]; then
        rm ~/.claude/$dir
        warn "Removed dangling symlink ~/.claude/$dir (no longer in dotfiles)"
    fi
done

# Claude Code managed settings (permission deny rules)
# Copied, not symlinked, and left owned by root: a policy file that the invoking
# user can rewrite is not a policy file. Claude Code reads managed settings but
# never writes them, and project settings cannot override them, so the deny
# rules survive both an app write and a per-project relaxation.
managed_dir="/Library/Application Support/ClaudeCode"
if cmp -s ~/dotfiles/claude/managed-settings.json "$managed_dir/managed-settings.json"; then
    info "Claude Code managed settings already current"
else
    info "Installing Claude Code managed settings (requires sudo)"
    sudo mkdir -p "$managed_dir"
    sudo cp ~/dotfiles/claude/managed-settings.json "$managed_dir/managed-settings.json"
    sudo chown root:wheel "$managed_dir/managed-settings.json"
    sudo chmod 644 "$managed_dir/managed-settings.json"
fi

# Codex config
# The base ~/.codex/config.toml is left alone — Codex writes trusted projects,
# plugin state and marketplaces into it. Preferences live in a profile file,
# layered on top via `codex -p dotfiles` (see the codex() wrapper in
# shell/profile), which Codex reads but never writes.
mkdir -p ~/.codex
create_symlink ~/dotfiles/codex/dotfiles.config.toml ~/.codex/dotfiles.config.toml

# User bin directory
mkdir -p ~/bin
cd ~/dotfiles/bin
for file in *; do
    if [[ -f "$file" ]]; then
        create_symlink "$HOME/dotfiles/bin/$file" "$HOME/bin/$file"
    fi
done

# Git hooks
# pre-commit carries the no-machine-state guard that keeps app-written state out
# of this public repo. A guard nobody remembers to enable is not a guard, so
# install it here rather than leaving it as a manual step.
if command -v pre-commit >/dev/null 2>&1; then
    if (cd ~/dotfiles && pre-commit install >/dev/null 2>&1); then
        info "Installed pre-commit hooks"
    else
        warn "Could not install pre-commit hooks; run 'pre-commit install' in ~/dotfiles"
    fi
else
    warn "pre-commit not found; run 'brew bundle', then 'pre-commit install' in ~/dotfiles"
fi

# ============================================================================
# Final Steps
# ============================================================================

info "Installation complete!"
echo
echo "Next manual steps:"
echo "  1. Change default shell: chsh -s \$(which zsh)"
echo "  2. Restart your terminal or run: source ~/.zshrc"
echo "  3. Install Vim plugins: Open nvim and run :Lazy install"
echo "  4. Install Tmux plugins: Start tmux and press prefix + I"
echo "  5. Set up GitHub SSH keys"
echo "  6. Create ~/.gitconfig-local with this machine's signingkey (see CLAUDE.md)"
echo "  7. Start any required Homebrew services"
echo
echo "To update in the future, run this script again."
