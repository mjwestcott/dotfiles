# shellcheck shell=bash
#
# Executes commands at the start of an interactive session.
#

# Source profile.
[[ -e ~/dotfiles/shell/profile ]] && source ~/dotfiles/shell/profile

# Source Antidote (replaces Prezto).
source ~/.antidote/antidote.zsh
antidote load "${ZDOTDIR:-$HOME}"/.zsh_plugins.txt

# Configure zsh-autosuggestions for better performance
export ZSH_AUTOSUGGEST_USE_ASYNC=1

# Configure zsh-history-substring-search key bindings
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[OA' history-substring-search-up
bindkey '^[OB' history-substring-search-down

setopt HIST_IGNORE_SPACE
export HISTSIZE=100000
export SAVEHIST=100000
mkdir -p "$XDG_STATE_HOME/zsh"
export HISTFILE="$XDG_STATE_HOME/zsh/history"
[[ -z "$TMPDIR" ]] && TMPDIR=/tmp

# Setup homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Initialize zoxide (smarter cd)
eval "$(zoxide init zsh)"

# Source 'fzf'.
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

# GCP path.
source "$(brew --prefix)/share/google-cloud-sdk/path.zsh.inc"
source "$(brew --prefix)/share/google-cloud-sdk/completion.zsh.inc"

# Since it's provided by our prompt.
export VIRTUAL_ENV_DISABLE_PROMPT=1

# No pyenv. It had zero versions installed and was pinned to `system`, so it
# managed nothing while costing an eval on every shell. uv handles per-project
# Python; Homebrew provides the interpreter.

# Initalize rbenv.
command -v rbenv > /dev/null 2>&1 && eval "$(rbenv init -)"

# Initialize Starship prompt (replaces Spaceship)
eval "$(starship init zsh)"

# No conda init. The block that used to live here pointed at an Intel-Homebrew
# /usr/local/anaconda3 that does not exist on this machine, so it only ever added
# a bogus PATH entry. Conda is at /opt/homebrew/anaconda3 if it is ever wanted
# back: run `conda init zsh` and move the block it writes into this file.

source ~/.config/broot/launcher/bash/br
