[core]
        excludesfile = ~/.gitignore_global
        pager = delta

[init]
        defaultBranch = main

[user]
        name = Matt Westcott
        email = m.westcott@gmail.com
        signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOjL7JdsoYkRqtbXWQtMEIC4Jl84lgkNcKBUyw9iwG7s

# SSH rather than OpenPGP: gpg-agent's socket is unreachable from inside the
# safehouse sandbox that wraps the coding agents, because macOS treats a unix
# socket connect as network-outbound and safehouse has no gnupg feature to open
# it. ssh-agent is reachable via --enable=ssh, so signing works in and out of
# the sandbox. Work repos still use OpenPGP; see ~/.gitconfig-work.
[gpg]
        format = ssh

[gpg "ssh"]
        allowedSignersFile = ~/dotfiles/git/allowed_signers

# Conditional includes for work repositories
[includeIf "gitdir/i:~/work/"]
        path = ~/.gitconfig-work

[includeIf "gitdir/i:~/repos/work/"]
        path = ~/.gitconfig-work

[commit]
        gpgsign = true
        verbose = true

[alias]
        discard = checkout --
        unstage = reset --
        uncommit = reset --soft HEAD~

        # Plurals...
        branches = branch -a
        stashes = stash list
        remotes = remote -v
        tags = tag

[apply]
        whitespace = warn

[color]
        ui = auto

[color "diff"]
        meta = yellow
        frag = magenta bold
        commit = yellow bold
        old = red
        new = green
        whitespace = red reverse

[delta]
        # Core settings
        navigate = true                          # use n and N to move between diff sections
        light = false                            # dark terminal background
        syntax-theme = zenburn

        # Layout
        side-by-side = false                     # set to true for side-by-side diffs
        line-numbers = true
        line-numbers-zero-style = "dim syntax"
        line-numbers-minus-style = "red"
        line-numbers-plus-style = "green"

        # File headers
        file-style = "yellow bold"
        file-decoration-style = "yellow ul"

        # Hunk headers
        hunk-header-style = "file line-number syntax"
        hunk-header-decoration-style = "cyan box dim"

        # Diff colors - subtle highlighting
        minus-style = "normal #503030"          # Subtle red background
        minus-emph-style = "normal #804848"     # Word-level changes - brighter red
        plus-style = "normal #2a462a"           # Subtle green background
        plus-emph-style = "normal #486048"      # Word-level changes - brighter green

        # Commit info
        commit-decoration-style = "yellow box"
        commit-style = "yellow bold"

[interactive]
        diffFilter = delta --color-only

[diff]
        tool = nvimdiff
        colorMoved = default
        renames = copies  # Detect copies as well as renames.
        indentHeuristic = on
        algorithm = histogram  # Better hunk boundaries than the default myers.

[merge]
        # zdiff3 keeps the common lines that diff3 duplicates into both sides out
        # of the conflict region, which makes conflicts much smaller to read.
        conflictstyle = zdiff3
        log = true  # Include summaries of merged commits in newly created merge commit messages.

[difftool]
        prompt = false

[help]
        autocorrect = 1

[push]
        # Create the upstream branch on first push instead of erroring with the
        # set-upstream hint. This is what the gpc alias existed to work around.
        autoSetupRemote = true

[pull]
        rebase = true

[rebase]
        updateRefs = true

[fetch]
        prune = true      # Drop local refs for branches deleted on the remote.

# Record how each conflict was resolved and replay it if the same conflict shows
# up again. Worth having with rebase.updateRefs, where a stack gets replayed.
[rerere]
        enabled = true
        autoUpdate = true

[branch]
        sort = -committerdate  # Most recently worked on first.

[column]
        ui = auto

[url "git@github.com:"]
        insteadOf = "https://github.com/"
        insteadOf = "git://github.com/"
        insteadOf = "github:"
        insteadOf = "gh:"

[url "git@gist.github.com:"]
        insteadOf = "https://gist.github.com/"
        insteadOf = "git://gist.github.com/"
        insteadOf = "gist:"

[filter "lfs"]
        clean = git-lfs clean -- %f
        smudge = git-lfs smudge -- %f
        process = git-lfs filter-process
        required = true
